    <string name="shizuku_not_running_title">Shizuku is not running</string>
    <string name="shizuku_not_running">Start Shizuku and come back. Until then the standard method is used.</string>
    <string name="shizuku_description">APK Toolbox uses Shizuku to install and update clones without prompts. Grant access to enable it; until then the standard method is used.</string>
