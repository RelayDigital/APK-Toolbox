<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- The handle stays at the top and the actions at the bottom; what is between them scrolls
         when the sheet is taller than the screen, so neither can be pushed out of sight. -->
    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <include
            android:id="@+id/appCard"
            layout="@layout/view_app_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <!-- The package the clone is to have is taken by an app that is not a clone made here. -->
        <include
            android:id="@+id/notice"
            layout="@layout/view_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <include
            android:id="@+id/options"
            layout="@layout/view_clone_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- How it ended. It is part of what scrolls, so that it cannot move the buttons. -->
        <TextView
            android:id="@+id/textStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:visibility="gone"
            tools:text="@string/status_done" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Progress and the buttons; the bar keeps its place while idle, so the buttons do not move. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:visibility="invisible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonClone"
            style="@style/Widget.Material3Expressive.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/button_clone"
            app:icon="@drawable/ic_copy"
            app:iconGravity="textStart"
            app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.Medium" />

        <!-- A plain row: a button group would animate the widths of its buttons on every press. -->
        <LinearLayout
            android:id="@+id/resultActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSave"
                style="@style/Widget.Material3Expressive.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/button_save"
                app:icon="@drawable/ic_folder"
                app:iconGravity="textStart"
                app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.Medium" />

            <com.google.android.material.button.MaterialButton
                android:layout_marginStart="8dp"
                android:id="@+id/buttonInstall"
                style="@style/Widget.Material3Expressive.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/button_install"
                app:icon="@drawable/ic_install"
                app:iconGravity="textStart"
                app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.Medium" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
